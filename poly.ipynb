    "class Book:\n",
    "    def __init__(self,title,price):\n",
    "        self.price=price\n",
    "        self.title=title\n",
    "    \n",
    "    def __add__(self,other):\n",
    "        return self.price+other.price\n",
    "    \n",
    "b1=Book(\"Harry potter\",500)\n",
    "b2=Book(\"Rich dad poor dad\",350)\n",
    "\n",
    "print(b1)\n",
    "print(b2)\n",
    "print(f\"total={b1+b2}\")\n",
    "\n"
   ]
